# --- Application -----------------------------------------------------------
APP_NAME="Dice Rewards"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Must be the public HTTPS address; Telegram requires HTTPS for Mini Apps and webhooks.
APP_URL=https://dice.example.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# --- Database (MySQL 8+ / MariaDB 10.6+) -----------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dice
DB_USERNAME=dice
DB_PASSWORD=

# Shared hosting friendly drivers: everything in the database, no Redis needed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Comma-separated proxy IPs, or * when behind a provider's load balancer / Cloudflare.
TRUSTED_PROXIES=127.0.0.1

# --- Telegram (secrets: never commit real values) ---------------------------
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Bot username without @.
TELEGRAM_BOT_USERNAME=
# Random 32+ characters [A-Za-z0-9_-]; generate with: php -r "echo bin2hex(random_bytes(24));"
TELEGRAM_WEBHOOK_SECRET=
# Optional: short name of the Mini App created with /newapp in @BotFather.
TELEGRAM_MINI_APP_SHORT_NAME=
TELEGRAM_HTTP_TIMEOUT=8
# Local development only (ignored unless APP_ENV=local): log in without Telegram.
TELEGRAM_DEV_AUTH=false

# Mini App session lifetime in hours.
MINIAPP_SESSION_TTL_HOURS=12

# --- Scheduler alternatives for hosts without cron --------------------------
# Long random token enables GET /cron/run/{token} for an external cron service.
CRON_TOKEN=
# true = run the scheduler from normal web traffic (at most once per minute).
SCHEDULER_FALLBACK=false
